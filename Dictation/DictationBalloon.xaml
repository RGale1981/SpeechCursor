<UserControl x:Class="Windows.Dictation.DictationBalloon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Windows.Dictation" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" xmlns:b="clr-namespace:Windows.Behaviors"
             mc:Ignorable="d">
    
    <Grid x:Name="GridHost"
          Background="Transparent" 
          Margin="4">

        <i:Interaction.Behaviors>
            <b:DragMoveBehavior />
        </i:Interaction.Behaviors>

        <Border Background="White"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="10"
                Height="200"
                Width="400"/>

    </Grid>
    
</UserControl>
