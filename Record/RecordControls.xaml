<UserControl x:Class="SpeechCursor.Record.RecordControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:b="clr-namespace:SpeechCursor.Infrastructure.Behaviors"
             xmlns:local="clr-namespace:SpeechCursor.Record"
             d:DataContext="{d:DesignInstance Type=local:RecordControlsViewModel}"
             mc:Ignorable="d" 
             Background="Transparent"
             b:PopupDragBehavior.EnableDrag="True">
    
    <Grid x:Name="GridHost"
          Background="Transparent" 
          Margin="4" >

        <ToggleButton x:Name="ToggleRecord"
                      Content="REC"
                      Height="70"
                      Style="{StaticResource RecordToggleButtonStyle}" 
                      Width="70"
                      IsChecked="{Binding Toggled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

    </Grid>
    
</UserControl>